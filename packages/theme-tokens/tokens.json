{
  "$schema": "./tokens.schema.md",
  "meta": {
    "name": "FileFly Design Tokens",
    "version": "1.0.0",
    "slogan": "Let your files fly · 让文件飞",
    "logoGradient": "linear-gradient(135deg, #2E6BE6 0%, #00B8C4 100%)"
  },
  "themes": {
    "light": {
      "primary": "#2E6BE6",
      "primaryHover": "#1F5AD1",
      "primaryActive": "#1749B8",
      "accent": "#00B8C4",
      "success": "#1F9D55",
      "warning": "#D97706",
      "danger": "#DC2626",
      "bgApp": "#F3F6FC",
      "bgSidebar": "rgba(246,249,255,.86)",
      "bgContent": "#FFFFFF",
      "bgCard": "#FFFFFF",
      "bgHover": "rgba(46,107,230,.07)",
      "bgSelected": "rgba(46,107,230,.15)",
      "border": "#DDE4F2",
      "textPrimary": "#171A21",
      "textSecondary": "#5A6478",
      "textDisabled": "#9AA3B5",
      "highlight": "#FFE58F",
      "highlightText": "#1A1D22"
    },
    "dark": {
      "primary": "#4C8DFF",
      "primaryHover": "#3D7BE8",
      "primaryActive": "#2E66C9",
      "accent": "#22D3D9",
      "success": "#2ECC71",
      "warning": "#F59E0B",
      "danger": "#EF4444",
      "bgApp": "#0E1116",
      "bgSidebar": "rgba(14,17,22,.84)",
      "bgContent": "#161A20",
      "bgCard": "#1D222B",
      "bgHover": "rgba(76,141,255,.12)",
      "bgSelected": "rgba(76,141,255,.20)",
      "border": "#2A303C",
      "textPrimary": "#EAECF2",
      "textSecondary": "#98A2B8",
      "textDisabled": "#5A6478",
      "highlight": "#8A6D00",
      "highlightText": "#FFFFFF"
    }
  },
  "categoryColors": {
    "document": { "label": "文档", "icon": "#2E6BE6", "light": "#EDF3FE", "dark": "rgba(46,107,230,.16)" },
    "image": { "label": "图片", "icon": "#16A34A", "light": "#EAF7EF", "dark": "rgba(22,163,74,.16)" },
    "music": { "label": "音乐", "icon": "#D946EF", "light": "#FBEFFC", "dark": "rgba(217,70,239,.16)" },
    "video": { "label": "视频", "icon": "#7C3AED", "light": "#F3EEFC", "dark": "rgba(124,58,237,.16)" },
    "archive": { "label": "压缩包", "icon": "#D97706", "light": "#FDF4E7", "dark": "rgba(217,119,6,.16)" },
    "installer": { "label": "安装包", "icon": "#EA580C", "light": "#FDF0E9", "dark": "rgba(234,88,12,.16)" }
  },
  "tagPresetColors": [
    { "name": "红", "en": "red", "hex": "#E5484D" },
    { "name": "橙", "en": "orange", "hex": "#F76B15" },
    { "name": "黄", "en": "yellow", "hex": "#FFC53D" },
    { "name": "绿", "en": "green", "hex": "#46A758" },
    { "name": "青", "en": "cyan", "hex": "#00B8C4" },
    { "name": "蓝", "en": "blue", "hex": "#2E6BE6" },
    { "name": "紫", "en": "purple", "hex": "#8E4EC6" },
    { "name": "灰", "en": "gray", "hex": "#8B8D98" }
  ],
  "diskBarRules": {
    "safe": { "max": 69, "token": "accent" },
    "warn": { "min": 70, "max": 89, "token": "warning" },
    "critical": { "min": 90, "token": "danger" }
  },
  "typography": {
    "ui": ["Segoe UI Variable", "Segoe UI", "SF Pro", "-apple-system", "Microsoft YaHei UI", "PingFang SC", "sans-serif"],
    "mono": ["Cascadia Code", "SF Mono", "Consolas", "monospace"]
  },
  "effects": {
    "glass": "backdrop-filter: blur(24px) saturate(1.4)",
    "radius": "8px",
    "themeSwitchMs": 150,
    "previewScale": "scale(.96→1) + fade 120ms"
  }
}
